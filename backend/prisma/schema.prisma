generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  name                  String                @db.VarChar(80)
  email                 String                @unique @db.VarChar(254)
  passwordHash          String                @map("password_hash")
  role                  String                @default("USER") @db.VarChar(20)
  educationTrack        String                @default("SECONDARY") @map("education_track") @db.VarChar(20)
  institutionName       String?               @map("institution_name") @db.VarChar(160)
  programme             String?               @db.VarChar(160)
  studyLevel            String?               @map("study_level") @db.VarChar(40)
  currentAcademicYear   String                @default("2026–2027") @map("current_academic_year") @db.VarChar(30)
  currentTerm           String                @default("Term 1") @map("current_term") @db.VarChar(20)
  currentSemester       String                @default("Semester 1") @map("current_semester") @db.VarChar(20)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  subjects              Subject[]
  assessmentScores      AssessmentScore[]
  universityCourses     UniversityCourse[]
  universityResults     UniversityCourseResult[]
  supportConversation   SupportConversation?
  supportMessages       SupportMessage[]      @relation("SupportMessageSender")
  aiQuizAttempts        AiQuizAttempt[]
  subscriptions         UserSubscription[]
  aiUsageDaily          AiUsageDaily[]
  paymentTransactions   PaymentTransaction[]
  packPurchases         StudyPackPurchase[]

  @@map("users")
}

model Subject {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  name              String            @db.VarChar(70)
  normalizedName    String            @map("normalized_name") @db.VarChar(70)
  targetPercentage  Int               @default(75) @map("target_percentage")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentScores  AssessmentScore[]

  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
  @@map("subjects")
}

model AssessmentScore {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  subjectId      String   @map("subject_id")
  academicYear   String   @map("academic_year") @db.VarChar(30)
  term           String   @db.VarChar(20)
  ca1            Float?
  ca1Max         Float    @default(10) @map("ca1_max")
  ca2            Float?
  ca2Max         Float    @default(10) @map("ca2_max")
  ca3            Float?
  ca3Max         Float    @default(10) @map("ca3_max")
  exam           Float?
  examMax        Float    @default(70) @map("exam_max")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([subjectId, academicYear, term])
  @@index([userId, academicYear, term])
  @@map("assessment_scores")
}


model UniversityCourse {
  id          String                   @id @default(cuid())
  userId      String                   @map("user_id")
  code        String                   @db.VarChar(30)
  title       String                   @db.VarChar(120)
  creditUnits Int                      @map("credit_units")
  targetScore Int                      @default(70) @map("target_score")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results     UniversityCourseResult[]

  @@unique([userId, code])
  @@index([userId, createdAt])
  @@map("university_courses")
}

model UniversityCourseResult {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  courseId     String           @map("course_id")
  academicYear String           @map("academic_year") @db.VarChar(30)
  semester     String           @db.VarChar(20)
  caScore      Float?           @map("ca_score")
  caMax        Float            @default(30) @map("ca_max")
  examScore    Float?           @map("exam_score")
  examMax      Float            @default(70) @map("exam_max")
  assessments  Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       UniversityCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, academicYear, semester])
  @@index([userId, academicYear, semester])
  @@map("university_course_results")
}

model SupportConversation {
  id        String           @id @default(cuid())
  userId    String           @unique @map("user_id")
  status    String           @default("OPEN") @db.VarChar(20)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String             @id @default(cuid())
  conversationId String             @map("conversation_id")
  senderId       String             @map("sender_id")
  body           String             @db.VarChar(4000)
  readAt         DateTime?          @map("read_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
  @@map("support_messages")
}


model AiQuizAttempt {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  title             String   @db.VarChar(120)
  subject           String   @default("") @db.VarChar(100)
  topic             String   @default("") @db.VarChar(160)
  difficulty        String   @default("medium") @db.VarChar(20)
  questionData      Json     @map("question_data")
  submittedAnswers  Json?    @map("submitted_answers")
  resultData        Json?    @map("result_data")
  status            String   @default("IN_PROGRESS") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_quiz_attempts")
}


model UserSubscription {
  id                       String   @id @default(cuid())
  userId                   String   @map("user_id")
  planCode                 String   @map("plan_code") @db.VarChar(30)
  status                   String   @default("TRIALING") @db.VarChar(20)
  trialStartedAt           DateTime? @map("trial_started_at")
  trialEndsAt              DateTime? @map("trial_ends_at")
  currentPeriodStart       DateTime? @map("current_period_start")
  currentPeriodEnd         DateTime? @map("current_period_end")
  cancelAtPeriodEnd         Boolean  @default(false) @map("cancel_at_period_end")
  providerCustomerCode      String?  @map("provider_customer_code") @db.VarChar(120)
  providerSubscriptionCode  String?  @map("provider_subscription_code") @db.VarChar(120)
  providerSubscriptionToken String?  @map("provider_subscription_token") @db.VarChar(1000)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, currentPeriodEnd])
  @@index([trialEndsAt])
  @@map("user_subscriptions")
}

model PaymentTransaction {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  reference     String    @unique @db.VarChar(120)
  provider      String    @default("paystack") @db.VarChar(30)
  planCode      String    @map("plan_code") @db.VarChar(50)
  amountMinor   Int       @map("amount_minor")
  currency      String    @default("USD") @db.VarChar(3)
  status        String    @default("PENDING") @db.VarChar(20)
  checkoutUrl   String?   @map("checkout_url") @db.VarChar(1000)
  paidAt        DateTime? @map("paid_at")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @db.VarChar(30)
  eventId     String   @map("event_id") @db.VarChar(160)
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model AiUsageDaily {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  usageDate  DateTime @map("usage_date") @db.Date
  total      Int      @default(0)
  toolCounts Json     @default("{}") @map("tool_counts")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@index([usageDate])
  @@map("ai_usage_daily")
}

model StudyPack {
  id              String   @id @default(cuid())
  slug            String   @unique @db.VarChar(80)
  title           String   @db.VarChar(160)
  description     String   @db.VarChar(1000)
  educationTrack  String   @default("BOTH") @map("education_track") @db.VarChar(20)
  priceUsdCents   Int      @map("price_usd_cents")
  published       Boolean  @default(false)
  content         Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  purchases       StudyPackPurchase[]

  @@index([published, educationTrack])
  @@map("study_packs")
}

model StudyPackPurchase {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  packId           String    @map("pack_id")
  paymentReference String    @unique @map("payment_reference") @db.VarChar(120)
  status           String    @default("PENDING") @db.VarChar(20)
  amountMinor      Int       @map("amount_minor")
  currency         String    @default("USD") @db.VarChar(3)
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack             StudyPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([userId, packId])
  @@index([userId, status])
  @@map("study_pack_purchases")
}

model InstitutionLicense {
  id             String   @id @default(cuid())
  institutionName String  @map("institution_name") @db.VarChar(180)
  contactName    String   @map("contact_name") @db.VarChar(120)
  contactEmail   String   @map("contact_email") @db.VarChar(254)
  seatCount      Int      @default(25) @map("seat_count")
  status         String   @default("LEAD") @db.VarChar(20)
  notes          String?  @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("institution_licenses")
}
