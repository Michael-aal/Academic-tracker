generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  name                  String                @db.VarChar(80)
  email                 String                @unique @db.VarChar(254)
  passwordHash          String                @map("password_hash")
  role                  String                @default("USER") @db.VarChar(20)
  sessionVersion        Int                   @default(0) @map("session_version")
  educationTrack        String                @default("SECONDARY") @map("education_track") @db.VarChar(20)
  institutionName       String?               @map("institution_name") @db.VarChar(160)
  programme             String?               @db.VarChar(160)
  studyLevel            String?               @map("study_level") @db.VarChar(40)
  currentAcademicYear   String                @default("2026–2027") @map("current_academic_year") @db.VarChar(30)
  currentTerm           String                @default("Term 1") @map("current_term") @db.VarChar(20)
  currentSemester       String                @default("Semester 1") @map("current_semester") @db.VarChar(20)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  subjects              Subject[]
  assessmentScores      AssessmentScore[]
  universityCourses     UniversityCourse[]
  universityResults     UniversityCourseResult[]
  supportConversation   SupportConversation?
  supportMessages       SupportMessage[]      @relation("SupportMessageSender")
  aiQuizAttempts        AiQuizAttempt[]
  dataRecords           UserDataRecord[]
  subjectDeletions       SubjectDeletion[]
  aiUsageEvents         AiUsageEvent[]
  aiUsageRecords        AiUsageRecord[]
  premiumAccess         PremiumAccess?
  creditWallet          CreditWallet?
  creditLots            CreditLot[]
  creditLedger          CreditLedger[]
  paymentTransactions   PaymentTransaction[]
  notifications         Notification[]          @relation("NotificationRecipient")
  sentNotifications    Notification[]          @relation("NotificationCreator")

  @@map("users")
}

model Subject {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  name              String            @db.VarChar(70)
  normalizedName    String            @map("normalized_name") @db.VarChar(70)
  targetPercentage  Int               @default(75) @map("target_percentage")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentScores  AssessmentScore[]

  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
  @@map("subjects")
}

model AssessmentScore {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  subjectId      String   @map("subject_id")
  academicYear   String   @map("academic_year") @db.VarChar(30)
  term           String   @db.VarChar(20)
  ca1            Float?
  ca1Max         Float    @default(10) @map("ca1_max")
  ca2            Float?
  ca2Max         Float    @default(10) @map("ca2_max")
  ca3            Float?
  ca3Max         Float    @default(10) @map("ca3_max")
  exam           Float?
  examMax        Float    @default(70) @map("exam_max")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([subjectId, academicYear, term])
  @@index([userId, academicYear, term])
  @@map("assessment_scores")
}


model UniversityCourse {
  id          String                   @id @default(cuid())
  userId      String                   @map("user_id")
  code        String                   @db.VarChar(30)
  title       String                   @db.VarChar(120)
  creditUnits Int                      @map("credit_units")
  targetScore Int                      @default(70) @map("target_score")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results     UniversityCourseResult[]

  @@unique([id, userId])
  @@unique([userId, code])
  @@index([userId, createdAt])
  @@map("university_courses")
}

model UniversityCourseResult {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  courseId     String           @map("course_id")
  academicYear String           @map("academic_year") @db.VarChar(30)
  semester     String           @db.VarChar(20)
  caScore      Float?           @map("ca_score")
  caMax        Float            @default(30) @map("ca_max")
  examScore    Float?           @map("exam_score")
  examMax      Float            @default(70) @map("exam_max")
  assessments  Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       UniversityCourse @relation(fields: [courseId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([courseId, academicYear, semester])
  @@index([userId, academicYear, semester])
  @@map("university_course_results")
}

model SupportConversation {
  id        String           @id @default(cuid())
  userId    String           @unique @map("user_id")
  status    String           @default("OPEN") @db.VarChar(20)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String             @id @default(cuid())
  conversationId String             @map("conversation_id")
  senderId       String             @map("sender_id")
  body           String             @db.VarChar(4000)
  readAt         DateTime?          @map("read_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
  @@map("support_messages")
}


model AiQuizAttempt {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  title             String   @db.VarChar(120)
  subject           String   @default("") @db.VarChar(100)
  topic             String   @default("") @db.VarChar(160)
  difficulty        String   @default("medium") @db.VarChar(20)
  questionData      Json     @map("question_data")
  submittedAnswers  Json?    @map("submitted_answers")
  resultData        Json?    @map("result_data")
  status            String   @default("IN_PROGRESS") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_quiz_attempts")
}

model UserDataRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String   @db.VarChar(40)
  recordId  String   @map("record_id") @db.VarChar(120)
  data      Json
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, recordId])
  @@index([userId, kind, updatedAt])
  @@index([userId, kind, deletedAt])
  @@map("user_data_records")
}


model AiUsageEvent {
  id        String   @id
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_events")
}


model SubjectDeletion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subjectId String   @map("subject_id")
  deletedAt DateTime @default(now()) @map("deleted_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId, deletedAt])
  @@map("subject_deletions")
}


model PremiumAccess {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  planKey   String   @map("plan_key") @db.VarChar(20)
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("premium_access")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("credit_wallets")
}

model CreditLot {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  originalCredits  Int      @map("original_credits")
  remainingCredits Int      @map("remaining_credits")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt, createdAt])
  @@map("credit_lots")
}

model CreditLedger {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  delta       Int
  kind        String   @db.VarChar(30)
  reference   String?  @unique @db.VarChar(120)
  description String   @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  reference   String   @unique @db.VarChar(120)
  type        String   @db.VarChar(20)
  itemKey     String   @map("item_key") @db.VarChar(40)
  amountKobo  Int      @map("amount_kobo")
  baseAmountUsdCents Int @default(0) @map("base_amount_usd_cents")
  exchangeRateTenThousandths Int @default(0) @map("exchange_rate_ten_thousandths")
  exchangeRateAsOf DateTime? @map("exchange_rate_as_of")
  credits     Int      @default(0)
  durationDays Int     @default(0) @map("duration_days")
  creditValidityDays Int @default(30) @map("credit_validity_days")
  status      String   @default("PENDING") @db.VarChar(20)
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model AiUsageRecord {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  requestId         String   @map("request_id") @db.VarChar(64)
  action            String   @db.VarChar(30)
  provider          String   @db.VarChar(30)
  model             String   @db.VarChar(120)
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  reasoningTokens   Int      @default(0) @map("reasoning_tokens")
  creditsCharged    Int      @default(0) @map("credits_charged")
  usageKnown        Boolean  @default(false) @map("usage_known")
  status            String   @db.VarChar(24)
  providerStatus    Int      @default(0) @map("provider_status")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, model, createdAt])
  @@index([requestId])
  @@map("ai_usage_records")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  createdById String?  @map("created_by_id")
  title       String   @db.VarChar(120)
  body        String   @db.VarChar(4000)
  category    String   @default("ANNOUNCEMENT") @db.VarChar(30)
  metadata    Json?
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([createdById])
  @@map("notifications")
}


model AdminBootstrapOtp {
  email               String   @id @db.VarChar(254)
  pinHash             String   @map("pin_hash") @db.VarChar(100)
  expiresAt           DateTime @map("expires_at")
  attempts            Int      @default(0)
  lastSentAt          DateTime @map("last_sent_at")
  sendWindowStartedAt DateTime @map("send_window_started_at")
  sendsInWindow       Int      @default(1) @map("sends_in_window")
  createdAt           DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("admin_bootstrap_otps")
}


// Student social network. These records are deliberately separate from academic
// scores, course results, and private study records.
model CommunityProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  username       String   @unique @db.VarChar(30)
  usernameSet    Boolean  @default(false) @map("username_set")
  bio            String?  @db.VarChar(280)
  bestSubject    String?  @map("best_subject") @db.VarChar(100)
  interests      Json?
  avatarUrl      String?  @map("avatar_url") @db.VarChar(500)
  coverUrl       String?  @map("cover_url") @db.VarChar(500)
  visibility     String   @default("PUBLIC") @db.VarChar(16)
  status         String   @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([bestSubject])
  @@map("community_profiles")
}

model CommunityPost {
  id          String   @id @default(cuid())
  authorId    String   @map("author_id")
  body        String   @db.VarChar(5000)
  mediaUrl    String?  @map("media_url") @db.VarChar(1000)
  videoUrl    String?  @map("video_url") @db.VarChar(1000)
  subject     String?  @db.VarChar(100)
  visibility  String   @default("PUBLIC") @db.VarChar(16)
  sharedPostId String? @map("shared_post_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([subject, createdAt])
  @@map("community_posts")
}

model CommunitySavedPost {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@map("community_saved_posts")
}

model CommunityReaction {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  reaction  String   @default("LIKE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("community_reactions")
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@map("community_comments")
}

model CommunityFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  status      String   @default("PENDING") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@map("community_follows")
}

model StudyGroup {
  id             String   @id @default(cuid())
  ownerId        String   @map("owner_id")
  title          String   @db.VarChar(100)
  description    String   @db.VarChar(1000)
  subject        String?  @db.VarChar(100)
  educationTrack String?  @map("education_track") @db.VarChar(20)
  visibility     String   @default("PUBLIC") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([educationTrack, subject, createdAt])
  @@map("study_groups")
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") @db.VarChar(16)
  status    String   @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([groupId, userId])
  @@index([userId, status])
  @@map("group_memberships")
}


model VideoEngagement {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  videoId      String   @map("video_id") @db.VarChar(120)
  provider     String   @default("YOUTUBE") @db.VarChar(20)
  action       String   @db.VarChar(20)
  watchSeconds Int      @default(0) @map("watch_seconds")
  subject      String?  @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  @@index([userId, createdAt])
  @@index([userId, subject, createdAt])
  @@index([videoId, action])
  @@map("video_engagements")
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  code      String   @unique @db.VarChar(24)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  @@map("referral_codes")
}

model Referral {
  id             String   @id @default(cuid())
  inviterId      String   @map("inviter_id")
  referredUserId String   @unique @map("referred_user_id")
  code           String   @db.VarChar(24)
  status         String   @default("PENDING") @db.VarChar(20)
  qualifiedAt    DateTime? @map("qualified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  @@index([inviterId, createdAt])
  @@index([status, createdAt])
  @@map("referrals")
}

model ReferralReward {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  referralId String   @unique @map("referral_id")
  points     Int      @default(0)
  rewardType String   @map("reward_type") @db.VarChar(24)
  status     String   @default("PENDING") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([userId, createdAt])
  @@map("referral_rewards")
}

model ChatConversation {
  id          String   @id @default(cuid())
  kind        String   @default("DIRECT") @db.VarChar(16)
  createdById String   @map("created_by_id")
  groupId     String?  @map("group_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@index([groupId, updatedAt])
  @@map("chat_conversations")
}

model ChatMember {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime @default(now()) @map("joined_at")
  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
  @@map("chat_members")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  messageType    String   @default("TEXT") @map("message_type") @db.VarChar(16)
  body           String?  @db.VarChar(5000)
  mediaUrl       String?  @map("media_url") @db.VarChar(1000)
  replyToId      String?  @map("reply_to_id")
  createdAt      DateTime @default(now()) @map("created_at")
  editedAt       DateTime? @map("edited_at")
  deletedAt      DateTime? @map("deleted_at")
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("chat_messages")
}

model CallSession {
  id          String   @id @default(cuid())
  callerId    String   @map("caller_id")
  calleeId    String   @map("callee_id")
  callType    String   @default("AUDIO") @map("call_type") @db.VarChar(12)
  status      String   @default("RINGING") @db.VarChar(16)
  startedAt   DateTime @default(now()) @map("started_at")
  answeredAt  DateTime? @map("answered_at")
  endedAt     DateTime? @map("ended_at")
  @@index([calleeId, status, startedAt])
  @@index([callerId, startedAt])
  @@map("call_sessions")
}

model CallSignal {
  id        String   @id @default(cuid())
  callId    String   @map("call_id")
  senderId  String   @map("sender_id")
  kind      String   @db.VarChar(16)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  @@index([callId, createdAt])
  @@map("call_signals")
}


model CommunityBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@map("community_blocks")
}

model CommunityReport {
  id         String   @id @default(cuid())
  reporterId String   @map("reporter_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id") @db.VarChar(120)
  reason     String   @db.VarChar(40)
  details    String?  @db.VarChar(1000)
  status     String   @default("OPEN") @db.VarChar(16)
  reviewedBy String?  @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetType, targetId])
  @@map("community_reports")
}


model GroupInvitation {
  id             String   @id @default(cuid())
  groupId        String   @map("group_id")
  invitedUserId  String   @map("invited_user_id")
  invitedById    String   @map("invited_by_id")
  status         String   @default("PENDING") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status, createdAt])
  @@map("group_invitations")
}
