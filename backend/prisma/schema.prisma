generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  name                  String                @db.VarChar(80)
  email                 String                @unique @db.VarChar(254)
  passwordHash          String                @map("password_hash")
  role                  String                @default("USER") @db.VarChar(20)
  sessionVersion        Int                   @default(0) @map("session_version")
  educationTrack        String                @default("SECONDARY") @map("education_track") @db.VarChar(20)
  institutionName       String?               @map("institution_name") @db.VarChar(160)
  programme             String?               @db.VarChar(160)
  studyLevel            String?               @map("study_level") @db.VarChar(40)
  currentAcademicYear   String                @default("2026–2027") @map("current_academic_year") @db.VarChar(30)
  currentTerm           String                @default("Term 1") @map("current_term") @db.VarChar(20)
  currentSemester       String                @default("Semester 1") @map("current_semester") @db.VarChar(20)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  subjects              Subject[]
  assessmentScores      AssessmentScore[]
  universityCourses     UniversityCourse[]
  universityResults     UniversityCourseResult[]
  supportConversation   SupportConversation?
  supportMessages       SupportMessage[]      @relation("SupportMessageSender")
  aiQuizAttempts        AiQuizAttempt[]
  dataRecords           UserDataRecord[]
  subjectDeletions       SubjectDeletion[]
  aiUsageEvents         AiUsageEvent[]
  premiumAccess         PremiumAccess?
  creditWallet          CreditWallet?
  creditLots            CreditLot[]
  creditLedger          CreditLedger[]
  paymentTransactions   PaymentTransaction[]

  @@map("users")
}

model Subject {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  name              String            @db.VarChar(70)
  normalizedName    String            @map("normalized_name") @db.VarChar(70)
  targetPercentage  Int               @default(75) @map("target_percentage")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentScores  AssessmentScore[]

  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
  @@map("subjects")
}

model AssessmentScore {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  subjectId      String   @map("subject_id")
  academicYear   String   @map("academic_year") @db.VarChar(30)
  term           String   @db.VarChar(20)
  ca1            Float?
  ca1Max         Float    @default(10) @map("ca1_max")
  ca2            Float?
  ca2Max         Float    @default(10) @map("ca2_max")
  ca3            Float?
  ca3Max         Float    @default(10) @map("ca3_max")
  exam           Float?
  examMax        Float    @default(70) @map("exam_max")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([subjectId, academicYear, term])
  @@index([userId, academicYear, term])
  @@map("assessment_scores")
}


model UniversityCourse {
  id          String                   @id @default(cuid())
  userId      String                   @map("user_id")
  code        String                   @db.VarChar(30)
  title       String                   @db.VarChar(120)
  creditUnits Int                      @map("credit_units")
  targetScore Int                      @default(70) @map("target_score")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results     UniversityCourseResult[]

  @@unique([id, userId])
  @@unique([userId, code])
  @@index([userId, createdAt])
  @@map("university_courses")
}

model UniversityCourseResult {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  courseId     String           @map("course_id")
  academicYear String           @map("academic_year") @db.VarChar(30)
  semester     String           @db.VarChar(20)
  caScore      Float?           @map("ca_score")
  caMax        Float            @default(30) @map("ca_max")
  examScore    Float?           @map("exam_score")
  examMax      Float            @default(70) @map("exam_max")
  assessments  Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       UniversityCourse @relation(fields: [courseId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([courseId, academicYear, semester])
  @@index([userId, academicYear, semester])
  @@map("university_course_results")
}

model SupportConversation {
  id        String           @id @default(cuid())
  userId    String           @unique @map("user_id")
  status    String           @default("OPEN") @db.VarChar(20)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String             @id @default(cuid())
  conversationId String             @map("conversation_id")
  senderId       String             @map("sender_id")
  body           String             @db.VarChar(4000)
  readAt         DateTime?          @map("read_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
  @@map("support_messages")
}


model AiQuizAttempt {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  title             String   @db.VarChar(120)
  subject           String   @default("") @db.VarChar(100)
  topic             String   @default("") @db.VarChar(160)
  difficulty        String   @default("medium") @db.VarChar(20)
  questionData      Json     @map("question_data")
  submittedAnswers  Json?    @map("submitted_answers")
  resultData        Json?    @map("result_data")
  status            String   @default("IN_PROGRESS") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_quiz_attempts")
}

model UserDataRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String   @db.VarChar(40)
  recordId  String   @map("record_id") @db.VarChar(120)
  data      Json
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, recordId])
  @@index([userId, kind, updatedAt])
  @@index([userId, kind, deletedAt])
  @@map("user_data_records")
}


model AiUsageEvent {
  id        String   @id
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_events")
}


model SubjectDeletion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subjectId String   @map("subject_id")
  deletedAt DateTime @default(now()) @map("deleted_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId, deletedAt])
  @@map("subject_deletions")
}


model PremiumAccess {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  planKey   String   @map("plan_key") @db.VarChar(20)
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("premium_access")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("credit_wallets")
}

model CreditLot {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  originalCredits  Int      @map("original_credits")
  remainingCredits Int      @map("remaining_credits")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt, createdAt])
  @@map("credit_lots")
}

model CreditLedger {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  delta       Int
  kind        String   @db.VarChar(30)
  reference   String?  @unique @db.VarChar(120)
  description String   @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  reference   String   @unique @db.VarChar(120)
  type        String   @db.VarChar(20)
  itemKey     String   @map("item_key") @db.VarChar(40)
  amountKobo  Int      @map("amount_kobo")
  credits     Int      @default(0)
  durationDays Int     @default(0) @map("duration_days")
  creditValidityDays Int @default(30) @map("credit_validity_days")
  status      String   @default("PENDING") @db.VarChar(20)
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}
