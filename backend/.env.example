# Copy this file to .env for local development. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
FRONTEND_ORIGIN="http://localhost:5173,https://your-academic-tracker.vercel.app"
PORT=4000
NODE_ENV=development

# Optional administrator account/bootstrap controls (server-side only)
ADMIN_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional AI learning provider settings (server-side only)
OPENROUTER_API_KEY="replace-with-your-private-openrouter-key"
OPENROUTER_MODEL="openai/gpt-4o-mini"
AI_SITE_URL="https://academic-tracker-iota.vercel.app"

# Optional educational video search (Google Cloud YouTube Data API v3 key; server-side only)
YOUTUBE_API_KEY="replace-with-your-youtube-data-api-key"

# Subscription billing (Paystack secret and plan codes are private server-side settings).
# Create matching USD recurring plans in the Paystack dashboard before enabling checkout.
# Note: Paystack documents a USD minimum transaction of $2.00; the converted daily price
# ($0.52) cannot be charged as-is and remains disabled until the business price is revised.
PAYSTACK_SECRET_KEY="replace-with-test-secret-key"
PAYSTACK_PLAN_DAILY=""
PAYSTACK_PLAN_WEEKLY=""
PAYSTACK_PLAN_MONTHLY=""
PAYSTACK_PLAN_YEARLY=""
PAYSTACK_DISABLE_TOKEN=""
