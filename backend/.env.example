# Copy this file to .env for local development. Never commit real secrets.
# Official owner login. Configure the same values in Render environment settings.
# Optional recovery credential for an existing configured administrator; not used for PIN setup.
ADMIN_EMAIL="academictracker@gmail.com"
ADMIN_PASSWORD=""\n# Resend email delivery. The sender address must be verified with Resend.\nRESEND_API_KEY=""\nEMAIL_FROM="Academic Tracker <no-reply@your-verified-domain.com>"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
FRONTEND_ORIGIN="http://localhost:5173,https://your-academic-tracker.vercel.app"
PORT=4000
NODE_ENV=development

# Optional AI learning provider settings (server-side only)
OPENROUTER_API_KEY="replace-with-your-private-openrouter-key"
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Optional second provider. Set XAI_API_KEY only if your xAI account has API access.
XAI_API_KEY=""
XAI_MODEL="grok-3-mini"
# Ordered fallback chain; only configured providers are called.
AI_PROVIDER_ORDER="openrouter,xai"
AI_SITE_URL="https://study-track-lilac.vercel.app"

# Optional educational video search (Google Cloud YouTube Data API v3 key; server-side only)
YOUTUBE_API_KEY="replace-with-your-youtube-data-api-key"

# Paystack payments (NGN; keep the secret key on Render only)
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_CALLBACK_URL="https://study-track-lilac.vercel.app/premium.html"

# Configure prices in kobo. These are examples of the required shape, not live prices.
# Set amountKobo >= 10000 (NGN 100) and credits/durationDays to your approved values.
PREMIUM_CATALOG_JSON='{"plans":{"daily":{"name":"Daily Premium","amountKobo":0,"durationDays":1,"credits":0,"creditValidityDays":30},"weekly":{"name":"Weekly Premium","amountKobo":0,"durationDays":7,"credits":0,"creditValidityDays":30},"monthly":{"name":"Monthly Premium","amountKobo":0,"durationDays":30,"credits":0,"creditValidityDays":30},"yearly":{"name":"Yearly Premium","amountKobo":0,"durationDays":365,"credits":0,"creditValidityDays":30}},"bundles":{"starter":{"name":"Starter","amountKobo":0,"credits":100,"creditValidityDays":7},"plus":{"name":"Plus","amountKobo":0,"credits":500,"creditValidityDays":30},"pro":{"name":"Pro","amountKobo":0,"credits":1000,"creditValidityDays":60}}}'
